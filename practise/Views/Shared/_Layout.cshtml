<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] · StudySpace</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body><header><a class="brand" asp-controller="Home" asp-action="Index"><span>▦</span> StudySpace</a><nav aria-label="Main navigation">
@if (User.Identity?.IsAuthenticated == true) {
<a asp-controller="Courses" asp-action="Index">Explore courses</a>
@if (User.IsInRole("Teacher")) { <a asp-controller="Courses" asp-action="Index" asp-route-mine="true">My teaching</a> }
@if (User.IsInRole("Student")) { <a asp-controller="Learning" asp-action="Index">My learning</a> }
<a asp-controller="Categories" asp-action="Index">Categories</a><a asp-controller="Account" asp-action="Profile">My profile</a>
<form asp-controller="Account" asp-action="Logout" method="post"><button class="nav-button">Sign out</button></form>
} else { <a asp-controller="Account" asp-action="Login">Sign in</a><a class="button small" asp-controller="Account" asp-action="Register">Create account</a> }
</nav></header><main>
@if (TempData["Success"] is string success) { <div class="notice success" role="status">@success</div> }
@if (TempData["Error"] is string error) { <div class="notice error" role="alert">@error</div> }
@RenderBody()
</main><footer>StudySpace <span>Learn together. Grow together.</span></footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script><script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
